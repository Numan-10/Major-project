<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0px 10px 0px 10px;
    font-size: 14px;
  }
  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }
  .fa-magnifying-glass {
    display: inline;
    margin-right: 5px;
  }
  .search-inp {
    border-radius: 25px;
    margin-left: 5rem;
    padding: 0.5rem 3rem 0.5rem 3rem;
  }
  @media only screen and (max-width: 768px) {
    .bnb {
      display: none !important;
    }

    .navbar-collapse {
      position: fixed;
      top: 0;
      left: 0;
      height: 100vh;
      width: 100%;
      background-color: #faebd7;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      transition: all 0.3s ease-in;
      z-index: 1050;
    }
    .navbar-nav {
      width: 100%;
    }
    .ALL {
      margin-top: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 1rem;
    }
    .Airhome {
      font-weight: 500;
    }

    .navbar-collapse.show {
      z-index: 1040;
    }
    .navbar-toggler {
      z-index: 1050;
    }
    .search-btn {
      margin-right: 1rem;
    }
    .search-inp {
      width: 50%;
      padding-left: 1rem;
    }
  }
</style>

<nav class="navbar navbar-expand-md bg-body-light sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"
      ><i class="fa-brands fa-airbnb"></i
    ></a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNav"
      aria-controls="navbarNav"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <div class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link bnb" href="/listings">Wanderlust</a>
        </li>
      </div>

      <div class="navbar-nav ms-auto ml-3">
        <form class="d-flex" role="search">
          <input
            class="form-control me-2 search-inp"
            type="search"
            placeholder="Search Destinations"
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>

      <div class="navbar-nav ms-auto ALL">
        <li class="nav-item">
          <a class="nav-link Airhome" href="/listings/new">Airbnb your home</a>
        </li>
        <% if(!currUser){%>
        <li class="nav-item">
          <a class="nav-link" aria-current="page" href="/signup"
            ><strong>Sign Up</strong></a
          >
        </li>
        <li class="nav-item">
          <a class="nav-link" href="/login"
            ><strong> <button class="btn btn-success">Login</button></strong></a
          >
        </li>
        <% }%> <% if(currUser){%>
        <li class="nav-item">
          <a class="nav-link" href="/logout"><strong>Logout</strong> </a>
        </li>
        <%}%>
      </div>
    </div>
  </div>
</nav>
