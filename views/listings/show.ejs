<% layout("/layouts/biolerplate") %>
<style>
  .container{
  padding-left: 0px;
}
</style>
<script>
  const mapToken = "<%=process.env.MAP_TOKEN%>";
  // const coordinates = <%- JSON.stringify(data.geometry.coordinates) %>;
  const listing = <%- JSON.stringify(data) %>;
  console.log("data:", listing);
  // console.log("Coordinates:", coordinates);
</script>

<div class="row mt-3">
  <div class="col-8 offset-2">
    <h3><b><%=data.title%></b></h3>
  </div>

  <!-- <div class="card col-6 offset-2">
   <div class="show-card mt-3"> -->
  <!-- <div class="card" > //style="width: 18rem" -->
  <div class="card col-6 offset-2 listing-card" style="width: 37vmax">
    <img
      src="<%=data.image.Url%>"
      class="card-img-top show-image"
      alt="Listing
      Details"
    />
    <div class="card-body">
      <p class="card-text"><i>Owned by <%= data.owner.username %></i></p>
      <p class="card-text"><%= data.description %></p>
      <p class="card-text">&#8377;<%= data.price.toLocaleString("en-IN") %></p>
      <p class="card-text"><%=data.location%></p>
      <p class="card-text"><%=data.country%></p>
    </div>
  </div>

  <%if(currUser && currUser._id.equals(data.owner._id)){ %>
  <div class="btns">
    <a href="/listings/<%=data._id%>/edit" class="btn btn-dark offset-2 add-btn"
      >Edit</a
    >

    <form method="POST" action="/listings/<%=data._id%>?_method=DELETE">
      <button class="btn btn-dark offset-4">Delete</button>
    </form>
  </div>
  <% }%>
  <div class="col-8 offset-2 mb-3">
    <%if(currUser){%>
    <hr />
    <h4>Leave a Review</h4>
    <form
      action="/listings/<%= data.id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >
      <!-- <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <input
          type="range"
          min="1"
          max="5"
          id="rating"
          class="form-range"
          name="review[rating]"
        />
      </div> -->
      <label for="rating" class="form-label">Rating</label>
      <div class="mb-3">
        <fieldset class="starability-slot">
          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="1"
            checked
            aria-label="No rating."
          />
          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
          />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />
          <label for="first-rate3" title="Average">3 stars</label>
          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>
      <div>
        <label for="comment" class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          class="form-control mb-2"
          id="comment"
          cols="30"
          rows="5"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comments for review</div>
      </div>
      <button class="btn btn-outline-dark btn-control">Submit</button>
    </form>
    <hr />
    <%}%> <%if(data.reviews.length > 0){%>
    <div class="row">
      <p><b>All Reviews</b></p>
      <%for(review of data.reviews){%>
      <div class="card col-5 mt-3 ms-2">
        <div class="card-body">
          <h5 class="card-title">@<%=review.author.username%></h5>
          <p
            class="starability-result card-text"
            data-rating="<%=review.rating%>"
          ></p>
          <p class="card-text"><%=review.comment%></p>
          <form
            class="mb-2"
            method="POST"
            action="/listings/<%=data._id%>/reviews/<%=review._id %>?_method=DELETE"
          >
            <button class="btn btn-sm btn-dark">Delete</button>
          </form>
        </div>
      </div>
      <%}%>
    </div>
    <%}%>
    <hr>
    <div class="col-6 mb-3">
      <h3>Where you’ll be</h3>
      <div id="map"></div>
    </div>
  </div>
 
</div>

<script src="/js/map.js"></script>
